# ============================================================================
# CONFIGURACIÓN DE API UBIQUITI
# ============================================================================
# URL de la API de Ubiquiti NMS
UBIQUITI_API_URL=https://tu-nms-url.com/nms/api/v2.1

# Token de autenticación de Ubiquiti
UBIQUITI_API_TOKEN=tu_token_aqui

# Verificar certificado SSL (true/false)
UBIQUITI_VERIFY_SSL=true

# ============================================================================
# CONFIGURACIÓN DE INFLUXDB
# ============================================================================
# Host de InfluxDB
INFLUXDB_HOST=influxdb

# Puerto de InfluxDB
INFLUXDB_PORT=8086

# Usuario administrador de InfluxDB
INFLUXDB_ADMIN_USER=admin

# Contraseña del administrador de InfluxDB
INFLUXDB_ADMIN_PASSWORD=contraseña_segura

# Nombre de la base de datos
INFLUXDB_DATABASE=monitoreo

# ============================================================================
# CONFIGURACIÓN DE DASHBOARD (React + Flask API)
# ============================================================================
# Puerto del dashboard (API + React)
DASHBOARD_PORT=5000
# Obligatoria. Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-key-change-me
# Credenciales usadas por el notificador Telegram para autenticarse contra la API.
# Deben existir como usuario en data/users.json (o se crean en el primer login).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=password
# Activar modo debug de Flask solo en desarrollo (true/false)
FLASK_DEBUG=false


# ============================================================================
# CONFIGURACIÓN DE MONITOREO
# ============================================================================
# Intervalo de consulta en segundos
POLLING_INTERVAL=300

# Retención del tráfico en InfluxDB (días). sites/devices/dept_summary son infinitos.
INFLUXDB_RETENTION_DAYS=90

# ============================================================================
# CONFIGURACIÓN DE TELEGRAM (alertas de juntas caídas)
# ============================================================================
# Token del bot (crearlo con @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat ID del grupo donde se envían las alertas
TELEGRAM_CHAT_ID=
# Intervalo de revisión en segundos
TELEGRAM_CHECK_INTERVAL=300
# Horas de caída mínimas antes de notificar
TELEGRAM_ALERT_DELAY_HOURS=3

# ============================================================================
# CONFIGURACIÓN DE DOCKER
# ============================================================================
# Nombre del proyecto Docker
COMPOSE_PROJECT_NAME=ubiquiti-monitor

# Variable para especificar el entorno (development, production)
ENVIRONMENT=development
